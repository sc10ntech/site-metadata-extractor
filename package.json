{
  "name": "site-metadata-extractor",
  "version": "1.0.7",
  "description": "web(site) resource metadata extractor",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rimraf dist",
    "collectCoverage": "jest --collectCoverage",
    "format": "prettier --write \"src/*.{js,ts,json,md}\"",
    "lint": "eslint 'src/**/*.{js,ts,tsx}' --quiet",
    "test": "jest --silent",
    "test:watch": "jest --silent --watch",
    "semantic-release": "semantic-release",
    "test:package": "node scripts/check-package.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sc10ntech/site-metadata-extractor.git"
  },
  "keywords": [
    "web",
    "seo",
    "metadata",
    "open-graph-protocol",
    "schema.org",
    "structured-data"
  ],
  "author": "info@sc10n.com",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/sc10ntech/site-metadata-extractor/issues"
  },
  "homepage": "https://github.com/sc10ntech/site-metadata-extractor#readme",
  "dependencies": {
    "cheerio": "^1.2.0",
    "lodash": "^4.17.20",
    "schema-dts": "^2.1.0",
    "xregexp": "^5.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.149",
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.4",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.3",
    "ts-jest": "^29.4.12",
    "typedoc": "^0.28.3",
    "typescript": "^5.0.4"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "jest": {
    "preset": "ts-jest",
    "verbose": true
  }
}
